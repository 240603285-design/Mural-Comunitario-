      <a href="#fotos">Fotos</a>
      <a href="#proposito">Propósito</a>
    </nav>
  </header>

  <main>
    <div class="hero">
      <div>
        <div class="etiqueta">Arte que une a la comunidad</div>
        <h1>Mural<br>Comunitario</h1>
